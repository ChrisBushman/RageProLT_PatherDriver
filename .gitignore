# build output
build/
*.o
*.bundle
*.kext

# macOS
.DS_Store

# compiled userspace tools (PPC-only; build on the Lombard) -- ignore every built
# mach64_* binary while keeping the sources/runners tracked
tools/mach64_*
!tools/mach64_*.c
!tools/mach64_*.h
!tools/mach64_*.sh

# test / probe run output (regenerated on the Lombard, not source)
*-out.txt
*-log.txt
*-result.txt
*-frames.txt
*.log

# Windows cross-compiled output (rebuild via win2k/kmd/Makefile)
win2k/**/*.exe
win2k/**/*.sys
win2k/**/*.dll
win2k/**/*.a
win2k/**/*.def
