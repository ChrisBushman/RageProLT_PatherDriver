<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mach64Accelerator kext Info.plist (skeleton).

  IOPCIMatch entries: vendor 0x1002 (ATI) + Rage LT Pro device IDs.
    0x4c49 'LI'  3D Rage LT Pro  <-- VERIFIED on this Lombard (rev 0xdc)
    0x4c42 'LB'  3D Rage LT Pro (AGP)   } kept as fallbacks for other
    0x4c50 'LP'  3D Rage LT Pro (PCI)   } LT Pro board variants

  Verified via ioreg on the target 2026-08-22:
    node  ATY,LTProParent@11  (IOPCIDevice, PCI dev 0x11)
    vendor-id=0x1002  device-id=0x4c49  revision-id=0xdc
    model="ATY,LT-C"  compatible="ATY,264LTPro"  MEMSIZE=0x800000 (8MB)
    two heads: ATY,264LTProA / ATY,264LTProB (dual CRTC)
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>          <string>com.local.Mach64Accelerator</string>
  <key>CFBundleName</key>                <string>Mach64Accelerator</string>
  <key>CFBundleExecutable</key>          <string>Mach64Accelerator</string>
  <key>CFBundleVersion</key>             <string>0.1</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleSignature</key>           <string>????</string>
  <key>CFBundlePackageType</key>         <string>KEXT</string>
  <!-- 10.3-era dependency names/versions (from ATIRagePro.kext), NOT the
       10.4+ com.apple.kpi.* names. -->
  <key>OSBundleLibraries</key>
  <dict>
    <key>com.apple.kernel.iokit</key>       <string>1.0.0b1</string>
    <key>com.apple.kernel.mach</key>        <string>1.0.0b1</string>
    <key>com.apple.iokit.IOPCIFamily</key>  <string>1.0.0b1</string>
    <key>com.apple.iokit.IOGraphicsFamily</key> <string>1.0.0b1</string>
  </dict>
  <key>IOKitPersonalities</key>
  <dict>
    <key>Mach64Accelerator</key>
    <dict>
      <key>CFBundleIdentifier</key>  <string>com.local.Mach64Accelerator</string>
      <key>IOClass</key>             <string>Mach64Accelerator</string>
      <key>IOProviderClass</key>     <string>IOPCIDevice</string>
      <key>IOPCIMatch</key>
      <string>0x4c491002 0x4c421002 0x4c501002</string>
      <!-- Distinct from ATIRagePro's "IOAccelerator" category so IOKit starts
           us ALONGSIDE it on the same IOPCIDevice (coexist, no takeover;
           display stays up). -->
      <key>IOMatchCategory</key>     <string>Mach64GLAccelerator</string>
      <!-- The GL user client class the plugin opens with type=1 -->
      <key>IOUserClientClass</key>   <string>Mach64GLUserClient</string>
    </dict>
  </dict>
</dict>
</plist>
